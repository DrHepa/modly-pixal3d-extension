# Pixal3D linux-x64-cp312-cuda124 native source refs.
#
# These refs are intentionally explicit and immutable. The build script does
# not fetch sources unless WHEELHOUSE_ALLOW_SOURCE_FETCH=1 is set.
#
# Confidence legend:
# - high: version tag maps directly to the required wheel version.
# - medium-high: upstream install flow points to this repo/branch/subdir, but
#   the existing aarch64 wheel does not embed a direct source commit.
# - medium: wheel metadata identifies the repo, but the exact aarch64 source
#   commit was not embedded in wheel metadata.

WHEELHOUSE_ALLOW_SOURCE_FETCH=1

# high: tag v0.21.0 -> commit 506816a1b6b6bb9557466f0411dc4f0bc256cb3c.
NATTEN_SOURCE_URL=https://github.com/SHI-Labs/NATTEN.git
NATTEN_SOURCE_REF=506816a1b6b6bb9557466f0411dc4f0bc256cb3c

# medium-high: TRELLIS.2 provides o-voxel as a repository subdirectory.
O_VOXEL_SOURCE_URL=https://github.com/microsoft/TRELLIS.2.git
O_VOXEL_SOURCE_REF=5565d240c4a494caaf9ece7a554542b76ffa36d3
O_VOXEL_SOURCE_SUBDIR=o-voxel

# medium: wheel metadata points to JeffreyXiang/CuMesh; exact aarch64 build
# commit was not embedded in the wheel.
CUMESH_SOURCE_URL=https://github.com/JeffreyXiang/CuMesh.git
CUMESH_SOURCE_REF=12289e1062f0603f2f0d0771b02e1395d247f26f

# medium: wheel metadata points to JeffreyXiang/FlexGEMM; exact aarch64 build
# commit was not embedded in the wheel.
FLEX_GEMM_SOURCE_URL=https://github.com/JeffreyXiang/FlexGEMM.git
FLEX_GEMM_SOURCE_REF=6dd94a859c26ee8246888502eada3dd8ad85532e

# high: tag v0.4.0 -> commit 253ac4fcea7de5f396371124af597e6cc957bfae.
NVDIFFRAST_SOURCE_URL=https://github.com/NVlabs/nvdiffrast.git
NVDIFFRAST_SOURCE_REF=253ac4fcea7de5f396371124af597e6cc957bfae

# medium-high: TRELLIS.2 setup installs JeffreyXiang/nvdiffrec renderutils;
# nvdiffrec_render wheel metadata itself is sparse.
NVDIFFREC_RENDER_SOURCE_URL=https://github.com/JeffreyXiang/nvdiffrec.git
NVDIFFREC_RENDER_SOURCE_REF=b296927cc7fd01c2ac1087c8065c4d7248f72da4
