{
  "id": "pixal3d",
  "kind": "model",
  "type": "model",
  "name": "Pixal3D",
  "version": "0.7.0",
  "source": "https://github.com/DrHepa/modly-pixal3d-extension",
  "author": "DrHepa",
  "description": "Pixal3D single-image, multi-image, and WorldSculpt workflows with native image/video scene preparation using official SAM3 and DA3.",
  "generator_class": "Pixal3DGenerator",
  "model_identity": {
    "source_model": "TencentARC/Pixal3D",
    "canonical_modly_model_id": null,
    "registration_status": "unregistered"
  },
  "inputs": [
    {
      "name": "image",
      "type": "image",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "mesh",
      "formats": [
        "glb"
      ],
      "pbr": true
    }
  ],
  "params_schema": [],
  "nodes": [
    {
      "id": "generate",
      "name": "Image to 3D",
      "type": "model.generate",
      "input": "image",
      "output": "mesh",
      "params_schema": [
        {
          "id": "resolution",
          "label": "Resolution",
          "type": "select",
          "default": 1024,
          "options": [
            {
              "value": 1024,
              "label": "1024"
            },
            {
              "value": 1536,
              "label": "1536"
            }
          ],
          "tooltip": "Generation resolution. Higher is slower and requires more VRAM."
        },
        {
          "id": "low_vram",
          "label": "Low VRAM",
          "type": "select",
          "default": "low_vram",
          "options": [
            {
              "value": "low_vram",
              "label": "Low VRAM"
            },
            {
              "value": "standard",
              "label": "Standard"
            }
          ],
          "tooltip": "Prefer low-VRAM mode for safer Pixal3D generation; Standard loads all models on GPU."
        },
        {
          "id": "manual_fov",
          "label": "Manual FOV",
          "type": "select",
          "default": "-1",
          "options": [
            {
              "value": "-1",
              "label": "Auto (MoGe)"
            },
            {
              "value": "0.2",
              "label": "0.2 rad"
            },
            {
              "value": "0.35",
              "label": "0.35 rad"
            },
            {
              "value": "0.5",
              "label": "0.5 rad"
            }
          ],
          "tooltip": "Auto uses MoGe camera estimation. Manual values skip MoGe and can help problematic inputs, but may cause perspective changes."
        },
        {
          "id": "texture_size",
          "label": "Texture Size",
          "type": "select",
          "default": 1024,
          "options": [
            {
              "value": 1024,
              "label": "1024"
            },
            {
              "value": 2048,
              "label": "2048"
            }
          ],
          "tooltip": "Final GLB texture atlas size. 1024 reduces VRAM during final texturing; 2048 is higher quality and uses higher VRAM."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 4294967295,
          "tooltip": "Seed for reproducibility. -1 uses a random seed."
        }
      ],
      "weight_groups": [
        "pixal3d-base"
      ]
    },
    {
      "id": "generate-mv",
      "name": "Multi-Image to 3D",
      "type": "model.generate",
      "input": "image",
      "inputs": [
        "image",
        "image",
        "image",
        "image"
      ],
      "input_labels": [
        "Primary view",
        "View 2",
        "View 3",
        "View 4"
      ],
      "output": "mesh",
      "params_schema": [
        {
          "id": "resolution",
          "label": "Resolution",
          "type": "select",
          "default": 1024,
          "options": [
            {
              "value": 1024,
              "label": "1024"
            },
            {
              "value": 1536,
              "label": "1536"
            }
          ],
          "tooltip": "Generation resolution. Higher is slower and requires more VRAM."
        },
        {
          "id": "low_vram",
          "label": "Low VRAM",
          "type": "select",
          "default": "low_vram",
          "options": [
            {
              "value": "low_vram",
              "label": "Low VRAM"
            },
            {
              "value": "standard",
              "label": "Standard"
            }
          ],
          "tooltip": "Prefer low-VRAM mode for safer Pixal3D generation; Standard loads all models on GPU."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 4294967295,
          "tooltip": "Seed for reproducibility. -1 uses a random seed."
        }
      ],
      "weight_groups": [
        "pixal3d-base",
        "pixal3d-mv",
        "da3-base"
      ]
    },
    {
      "id": "worldsculpt",
      "name": "WorldSculpt Scene to 3D",
      "type": "model.generate",
      "input": "scene",
      "output": "mesh",
      "params_schema": [
        {
          "id": "face_budget",
          "label": "Faces per Instance",
          "type": "int",
          "default": 1000000,
          "min": 1000,
          "max": 3000000,
          "tooltip": "Maximum faces per composed instance; geometry-only GLB."
        }
      ],
      "weight_groups": [
        "pixal3d-base",
        "worldsculpt-adapters"
      ]
    },
    {
      "id": "scene-from-images",
      "name": "Prepare Scene from Images",
      "type": "model.generate",
      "input": "image",
      "inputs": [
        "image",
        "image",
        "image",
        "image",
        "image",
        "image",
        "image",
        "image"
      ],
      "input_labels": [
        "Primary view",
        "View 2",
        "View 3",
        "View 4",
        "View 5",
        "View 6",
        "View 7",
        "View 8"
      ],
      "output": "scene",
      "params_schema": [
        {
          "id": "object_labels",
          "label": "Object Labels",
          "type": "string",
          "default": "chair,table,sofa,bed,cabinet,lamp,plant,appliance",
          "tooltip": "Comma-separated SAM3 text labels. Each label is tracked independently and kept through label-aware 3D deduplication."
        },
        {
          "id": "process_resolution",
          "label": "DA3 Processing Resolution",
          "type": "select",
          "default": 504,
          "options": [
            {
              "value": 392,
              "label": "392"
            },
            {
              "value": 504,
              "label": "504"
            },
            {
              "value": 630,
              "label": "630"
            }
          ],
          "tooltip": "DA3 processing bound. Intrinsics are explicitly rescaled from this processed resolution to the source frames."
        },
        {
          "id": "mask_erosion",
          "label": "Mask Erosion",
          "type": "int",
          "default": 1,
          "min": 0,
          "max": 8,
          "tooltip": "Erode SAM3 masks before depth unprojection to reduce boundary contamination."
        },
        {
          "id": "minimum_geometry_points",
          "label": "Minimum Geometry Points",
          "type": "int",
          "default": 128,
          "min": 16,
          "max": 100000,
          "tooltip": "Reject an instance in a frame when robust mask/depth filtering leaves fewer points."
        },
        {
          "id": "confidence_percentile",
          "label": "Depth Confidence Percentile",
          "type": "float",
          "default": 40,
          "min": 0,
          "max": 100,
          "step": 1,
          "tooltip": "Discard DA3 samples below this per-mask confidence percentile."
        },
        {
          "id": "depth_trim_low",
          "label": "Depth Trim Low",
          "type": "float",
          "default": 5,
          "min": 0,
          "max": 49,
          "step": 1,
          "tooltip": "Lower per-mask depth percentile retained for geometry."
        },
        {
          "id": "depth_trim_high",
          "label": "Depth Trim High",
          "type": "float",
          "default": 95,
          "min": 51,
          "max": 100,
          "step": 1,
          "tooltip": "Upper per-mask depth percentile retained for geometry."
        },
        {
          "id": "aabb_percentile_low",
          "label": "AABB Percentile Low",
          "type": "float",
          "default": 2,
          "min": 0,
          "max": 25,
          "step": 1,
          "tooltip": "Lower percentile used after accepted frames are merged."
        },
        {
          "id": "aabb_percentile_high",
          "label": "AABB Percentile High",
          "type": "float",
          "default": 98,
          "min": 75,
          "max": 100,
          "step": 1,
          "tooltip": "Upper percentile used after accepted frames are merged."
        },
        {
          "id": "min_reprojection_coverage",
          "label": "Minimum Reprojection Coverage",
          "type": "float",
          "default": 0.1,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "tooltip": "Reject object/frame geometry that does not project back onto enough of its SAM3 mask."
        },
        {
          "id": "dedup_iou_threshold",
          "label": "3D Deduplication IoU",
          "type": "float",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "tooltip": "Deduplicate only same-label AABBs above this 3D IoU."
        },
        {
          "id": "camera_consistency_tolerance",
          "label": "Camera Consistency Tolerance",
          "type": "float",
          "default": 0.15,
          "min": 0.01,
          "max": 0.5,
          "step": 0.01,
          "tooltip": "Reject DA3 frames whose source-resolution intrinsics drift too far from the sequence median."
        },
        {
          "id": "sam_score_threshold",
          "label": "SAM3 Score Threshold",
          "type": "float",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "tooltip": "Official SAM3 detection/tracking output threshold."
        }
      ],
      "weight_groups": [
        "sam3",
        "da3-base"
      ]
    },
    {
      "id": "scene-from-video",
      "name": "Prepare Scene from Video",
