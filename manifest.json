  "asset_requirements": {
    "strategy": "sentinel-files",
    "required": [
      "models/pixal3d/_shared/pixal3d-base/pipeline.json",
      "models/pixal3d/_shared/pixal3d-base/ckpts/ss_dec_conv3d_16l8_fp16.safetensors",
      "models/pixal3d/_shared/pixal3d-base/ckpts/ss_flow_img_dit_1_3B_64_bf16.safetensors",
      "models/pixal3d/_shared/pixal3d-base/ckpts/shape_dec_next_dc_f16c32_fp16.safetensors",
