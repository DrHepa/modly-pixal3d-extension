{
  "id": "pixal3d",
  "kind": "model",
  "type": "model",
  "name": "Pixal3D",
  "version": "0.1.0",
  "author": "DrHepa",
  "description": "Pixal3D image-to-3D Modly model extension. Outputs are aligned to the input image projection; angled inputs may produce angled meshes by design.",
  "generator_class": "Pixal3DGenerator",
  "model_identity": {
    "source_model": "TencentARC/Pixal3D",
    "canonical_modly_model_id": null,
    "registration_status": "unregistered"
  },
  "inputs": [
    { "name": "image", "type": "image", "required": true }
  ],
  "outputs": [
    { "name": "mesh", "formats": ["glb"], "pbr": true }
  ],
  "params_schema": [],
  "nodes": [
    {
      "id": "generate",
      "name": "Image to 3D",
      "type": "model.generate",
      "input": "image",
      "output": "mesh",
      "hf_repo": "TencentARC/Pixal3D",
      "download_check": "pipeline.json",
      "weight_owner_id": "generate",
      "hf_skip_prefixes": [
        "README.md",
        "requirements.txt",
        "requirements-hfdemo.txt",
        "assets/"
      ],
      "download_checks": [
        "models/pixal3d/generate/pipeline.json",
        "models/pixal3d/auxiliary/dinov3/config.json",
        "models/pixal3d/auxiliary/dinov3/preprocessor_config.json",
        "models/pixal3d/auxiliary/dinov3/model.safetensors",
        "models/pixal3d/auxiliary/rmbg/config.json",
        "models/pixal3d/auxiliary/rmbg/preprocessor_config.json",
        "models/pixal3d/auxiliary/rmbg/BiRefNet_config.py",
        "models/pixal3d/auxiliary/rmbg/birefnet.py",
        "models/pixal3d/auxiliary/rmbg/model.safetensors",
        "models/pixal3d/auxiliary/moge/model.pt",
        "models/pixal3d/auxiliary/naf/naf_release.pth"
      ],
      "params_schema": [
        {
          "id": "resolution",
          "label": "Resolution",
          "type": "select",
          "default": 1024,
          "options": [
            { "value": 1024, "label": "1024" },
            { "value": 1536, "label": "1536" }
          ],
          "tooltip": "Generation resolution. Higher is slower and requires more VRAM."
        },
        {
          "id": "low_vram",
          "label": "Low VRAM",
          "type": "select",
          "default": "low_vram",
          "options": [
            { "value": "low_vram", "label": "Low VRAM" },
            { "value": "standard", "label": "Standard" }
          ],
          "tooltip": "Prefer low-VRAM mode for safer Pixal3D generation; Standard loads all models on GPU."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 4294967295,
          "tooltip": "Seed for reproducibility. -1 uses a random seed."
        }
      ]
    }
  ],
  "asset_requirements": {
    "strategy": "sentinel-files",
    "required": [
      "models/pixal3d/generate/pipeline.json",
      "models/pixal3d/generate/ckpts/ss_dec_conv3d_16l8_fp16.safetensors",
      "models/pixal3d/generate/ckpts/ss_flow_img_dit_1_3B_64_bf16.safetensors",
      "models/pixal3d/generate/ckpts/shape_dec_next_dc_f16c32_fp16.safetensors",
      "models/pixal3d/generate/ckpts/slat_flow_img2shape_dit_1_3B_512_bf16.safetensors",
      "models/pixal3d/generate/ckpts/slat_flow_img2shape_dit_1_3B_1024_bf16.safetensors",
      "models/pixal3d/generate/ckpts/tex_dec_next_dc_f16c32_fp16.safetensors",
      "models/pixal3d/generate/ckpts/slat_flow_imgshape2tex_dit_1_3B_1024_bf16.safetensors",
      "models/pixal3d/auxiliary/dinov3/config.json",
      "models/pixal3d/auxiliary/dinov3/preprocessor_config.json",
      "models/pixal3d/auxiliary/dinov3/model.safetensors",
      "models/pixal3d/auxiliary/rmbg/config.json",
      "models/pixal3d/auxiliary/rmbg/preprocessor_config.json",
      "models/pixal3d/auxiliary/rmbg/BiRefNet_config.py",
      "models/pixal3d/auxiliary/rmbg/birefnet.py",
      "models/pixal3d/auxiliary/rmbg/model.safetensors",
      "models/pixal3d/auxiliary/moge/model.pt",
      "models/pixal3d/auxiliary/naf/naf_release.pth",
      "models/pixal3d/readiness.json"
    ],
    "pipeline_substitutions": {
      "strategy": "local-first-with-default-remote-fallback",
      "dino": {
        "local_root": "models/pixal3d/auxiliary/dinov3",
        "remote_fallback": "camenduru/dinov3-vitl16-pretrain-lvd1689m"
      },
      "rmbg": {
        "local_root": "models/pixal3d/auxiliary/rmbg",
        "remote_fallback": "camenduru/RMBG-2.0"
      }
    },
    "runtime_local_first": {
      "moge": {
        "local_checkpoint": "models/pixal3d/auxiliary/moge/model.pt",
        "remote_fallback": "Ruicheng/moge-2-vitl",
        "loader": "inference.load_moge_model"
      },
      "naf": {
        "local_checkpoint": "models/pixal3d/auxiliary/naf/naf_release.pth",
        "remote_fallback": "https://github.com/valeoai/NAF/releases/download/model/naf_release.pth",
        "loader": "hubconf.naf",
        "strict_kernel_note": "NAF checkpoint localization is separate from NATTEN/libnatten native kernel availability."
      }
    },
    "unlocalized_runtime_dependencies": []
  },
  "platforms": [
    { "platform": "linux-aarch64-cp312-nvidia-cuda", "status": "prepared" },
    { "platform": "linux-x64-nvidia-cuda", "status": "wheelhouse-needed" },
    { "platform": "windows-x64-cp311-nvidia-cuda", "status": "supported" },
    { "platform": "windows-x64-cp312-nvidia-cuda", "status": "prepared" },
    { "platform": "amd-rocm", "status": "unsupported" },
    { "platform": "macos", "status": "unsupported" },
    { "platform": "cpu-only", "status": "unsupported" }
  ],
  "assets": {
    "extension_root": "extensions/pixal3d",
    "model_roots": [
      "models/pixal3d/generate",
      "models/pixal3d/auxiliary/dinov3",
      "models/pixal3d/auxiliary/rmbg",
      "models/pixal3d/auxiliary/moge",
      "models/pixal3d/auxiliary/naf"
    ]
  },
  "entrypoints": {
    "setup": "setup.py",
    "generator": "generator.py"
  },
  "setup": {
    "entrypoint": "setup.py",
    "venv_dir": "venv",
    "default_downloads": false,
    "default_installs": true,
    "wheelhouse": "wheels",
    "wheelhouse_manifest": {
      "path": "wheelhouse.manifest.json",
      "schema_version": "release-wheelhouse/v1"
    }
  }
}
