      "models/pixal3d/auxiliary/naf/naf_release.pth",
      "models/pixal3d/readiness.json"
    ],
    "pipeline_substitutions": {
      "strategy": "modly-shared-local-required",
      "dino": {
        "local_root": "models/pixal3d/_shared/pixal3d-base/auxiliary/dinov3"
      },
      "rmbg": {
        "local_root": "models/pixal3d/_shared/pixal3d-base/auxiliary/rmbg"
      }
    },
    "runtime_local_first": {
      "moge": {
        "local_checkpoint": "models/pixal3d/_shared/pixal3d-base/auxiliary/moge/model.pt",
        "loader": "inference.load_moge_model"
      },
      "naf": {
        "local_checkpoint": "models/pixal3d/auxiliary/naf/naf_release.pth",
        "loader": "hubconf.naf",
        "strict_kernel_note": "NAF checkpoint localization is separate from NATTEN/libnatten native kernel availability.",
        "bootstrap_source": "https://github.com/valeoai/NAF/releases/download/model/naf_release.pth"
      }
    },
    "unlocalized_runtime_dependencies": []
  },
